{
  "_comment": "Fixed facts about the harness, taken from its code (controlplane/stages.py, cost/tiering.py, codegen/story_runner.py, gate upserts). No run state lives here.",
  "harnessName": "COBOL → Java Harness",
  "harnessTagline": "Forward engineering · graph-first · agent-driven",
  "weights": {
    "stageWeight": 0.4,
    "storyWeight": 0.6
  },
  "phases": [
    {
      "key": "understand",
      "label": "Understand",
      "summary": "Capture the business outcome, parse the COBOL estate into the Neo4j code graph and explore it.",
      "stageKeys": [
        "outcome",
        "intake",
        "parse",
        "graph",
        "explore"
      ]
    },
    {
      "key": "design",
      "label": "Design",
      "summary": "Grounded BRD, epics & stories, ranked seams, story plan, bounded contexts and service design.",
      "stageKeys": [
        "blueprint",
        "backlog",
        "seams",
        "plan",
        "domain",
        "design"
      ]
    },
    {
      "key": "migrate",
      "label": "Migrate",
      "summary": "Build generates the Java code story by story; Verify checks it behaves like the COBOL.",
      "stageKeys": [
        "build",
        "verify"
      ]
    }
  ],
  "stages": [
    {
      "key": "outcome",
      "label": "Outcome",
      "phase": "understand",
      "ordinal": 0,
      "gateKey": null,
      "mode": "deterministic",
      "roles": [],
      "input": "Business drivers from stakeholders",
      "work": "Record the modernization outcome and success measures",
      "output": "Outcome statement"
    },
    {
      "key": "intake",
      "label": "Intake",
      "phase": "understand",
      "ordinal": 1,
      "gateKey": null,
      "mode": "deterministic",
      "roles": [],
      "input": "source_code_to_analyse/<repo>",
      "work": "Discover COBOL, copybooks, JCL, BMS, CSD",
      "output": "Workspace + repo inventory"
    },
    {
      "key": "parse",
      "label": "Parse",
      "phase": "understand",
      "ordinal": 2,
      "gateKey": "parse",
      "mode": "deterministic",
      "roles": [],
      "input": "COBOL programs + copybooks",
      "work": "ProLeap extractor → schemaVersion 2 JSON",
      "output": "Program / paragraph / data-item contract"
    },
    {
      "key": "graph",
      "label": "Graph",
      "phase": "understand",
      "ordinal": 3,
      "gateKey": "graph",
      "mode": "deterministic",
      "roles": [
        "enrichment"
      ],
      "input": "Extractor JSON",
      "work": "Ingest into Neo4j: CALLS, PERFORMS, READS, WRITES, EXECUTES_CICS",
      "output": "Code graph (source of truth)"
    },
    {
      "key": "explore",
      "label": "Explore",
      "phase": "understand",
      "ordinal": 4,
      "gateKey": null,
      "mode": "llm",
      "roles": [
        "ask"
      ],
      "input": "Code graph",
      "work": "Ask the codebase: graph-grounded Q&A",
      "output": "Answers with graph citations"
    },
    {
      "key": "blueprint",
      "label": "Blueprint",
      "phase": "design",
      "ordinal": 5,
      "gateKey": "brd_groundedness",
      "mode": "llm",
      "roles": [
        "brd",
        "judge"
      ],
      "input": "Code graph",
      "work": "Subsystem map-reduce BRD, judged for groundedness, improved",
      "output": "BRD (:BRD node + brd_output HTML)"
    },
    {
      "key": "backlog",
      "label": "Backlog",
      "phase": "design",
      "ordinal": 6,
      "gateKey": "backlog_coverage",
      "mode": "llm",
      "roles": [
        "story"
      ],
      "input": "BRD requirements",
      "work": "Epics first, then stories + acceptance criteria per epic",
      "output": "Epics, stories, acceptance criteria"
    },
    {
      "key": "seams",
      "label": "Seams",
      "phase": "design",
      "ordinal": 7,
      "gateKey": null,
      "mode": "deterministic",
      "roles": [
        "seam"
      ],
      "input": "Code graph",
      "work": "Rank strangler-fig seams (pure Cypher, no LLM in scoring)",
      "output": "Ranked seam candidates"
    },
    {
      "key": "plan",
      "label": "Plan",
      "phase": "design",
      "ordinal": 8,
      "gateKey": "stories_dag",
      "mode": "deterministic",
      "roles": [],
      "input": "Backlog + seams",
      "work": "Dependency derivation + topological order",
      "output": "Acyclic story DAG"
    },
    {
      "key": "domain",
      "label": "Domain Design",
      "phase": "design",
      "ordinal": 9,
      "gateKey": null,
      "mode": "llm",
      "roles": [
        "design",
        "judge"
      ],
      "input": "BRD + seam signals",
      "work": "Bounded contexts, module-vs-microservice, DDD tactical design",
      "output": "Domain design (:DomainDesign)"
    },
    {
      "key": "design",
      "label": "Design",
      "phase": "design",
      "ordinal": 10,
      "gateKey": "design_data_ownership",
      "mode": "llm",
      "roles": [
        "design"
      ],
      "input": "Domain design + backlog",
      "work": "Technical design: services, APIs, persistence, ADRs",
      "output": "Technical design + module scaffold"
    },
    {
      "key": "build",
      "label": "Build",
      "phase": "migrate",
      "ordinal": 11,
      "gateKey": "code",
      "mode": "llm",
      "roles": [
        "codegen",
        "repair",
        "advisor"
      ],
      "input": "Story plan + context packs",
      "work": "Per story: tests (red) → implementation (green) → repair → quality gate",
      "output": "Spring Boot module in codegen_output/"
    },
    {
      "key": "verify",
      "label": "Verify",
      "phase": "migrate",
      "ordinal": 12,
      "gateKey": "equivalence",
      "mode": "deterministic",
      "roles": [
        "equivalence_triage"
      ],
      "input": "Golden master (COBOL) + candidate (Java) records",
      "work": "Field-aware diff with COMP-3 / scale / date tolerance",
      "output": "Verdict + seam-linked defect tickets"
    }
  ],
  "gates": [
    {
      "key": "parse",
      "stageKey": "parse",
      "label": "Parse",
      "threshold": "Extractor emits a schemaVersion 2 contract (stages.py gate key)"
    },
    {
      "key": "graph",
      "stageKey": "graph",
      "label": "Graph",
      "threshold": "Graph ingested (stages.py gate key)"
    },
    {
      "key": "brd_groundedness",
      "stageKey": "blueprint",
      "label": "BRD judge",
      "threshold": "Weighted judge score ≥ 4.2 and accuracy ≥ 3 (seed.py)"
    },
    {
      "key": "brd_logic_coverage",
      "stageKey": "blueprint",
      "label": "BRD logic coverage",
      "threshold": "Graph coverage ≥ BACKLOG_COVERAGE_MIN (default 0.8)"
    },
    {
      "key": "backlog_coverage",
      "stageKey": "backlog",
      "label": "Backlog coverage",
      "threshold": "Graph coverage ≥ BACKLOG_COVERAGE_MIN (default 0.8)"
    },
    {
      "key": "backlog_readiness",
      "stageKey": "backlog",
      "label": "Backlog readiness",
      "threshold": "Every BRD requirement covered; no orphan, duplicate or unknown-ref stories"
    },
    {
      "key": "seams_quality",
      "stageKey": "seams",
      "label": "Seam quality",
      "threshold": "seam/quality.py assess_seam_quality"
    },
    {
      "key": "stories_dag",
      "stageKey": "plan",
      "label": "Story DAG",
      "threshold": "Story dependency graph acyclic"
    },
    {
      "key": "plan_quality",
      "stageKey": "plan",
      "label": "Plan quality",
      "threshold": "planner/quality.py assess_plan_quality"
    },
    {
      "key": "domain_quality",
      "stageKey": "domain",
      "label": "Domain quality",
      "threshold": "domain/quality.py assess_domain_quality"
    },
    {
      "key": "design_generation_complete",
      "stageKey": "design",
      "label": "Design generated",
      "threshold": "A technical design exists"
    },
    {
      "key": "design_data_ownership",
      "stageKey": "design",
      "label": "Data ownership",
      "threshold": "Unique writer ownership per resource"
    },
    {
      "key": "technical_design_quality",
      "stageKey": "design",
      "label": "Technical design quality",
      "threshold": "technical_design/quality.py"
    },
    {
      "key": "code",
      "stageKey": "build",
      "label": "Code",
      "threshold": "Build stage gate key (stages.py)"
    },
    {
      "key": "story_behavior",
      "stageKey": "verify",
      "label": "Story behaviour",
      "threshold": "All stories verified"
    },
    {
      "key": "equivalence",
      "stageKey": "verify",
      "label": "Equivalence",
      "threshold": "All stories pass COBOL ↔ Java equivalence"
    }
  ],
  "agentRoles": [
    {
      "role": "enrichment",
      "label": "Enrichment",
      "tier": "haiku",
      "model": "claude-haiku-4-5-20251001",
      "envVar": "ENRICHMENT_MODEL",
      "stages": [
        "graph"
      ],
      "description": "Summarises programs and paragraphs onto graph nodes."
    },
    {
      "role": "ask",
      "label": "Ask",
      "tier": "haiku",
      "model": "claude-haiku-4-5-20251001",
      "envVar": "ASK_MODEL",
      "stages": [
        "explore"
      ],
      "description": "Answers questions about the codebase, grounded in graph queries."
    },
    {
      "role": "brd",
      "label": "BRD writer",
      "tier": "sonnet",
      "model": "claude-sonnet-4-6",
      "envVar": "BRD_AGENT_MODEL",
      "stages": [
        "blueprint"
      ],
      "description": "Map-reduce BRD: one subsystem per map call, reduced with an evidence map."
    },
    {
      "role": "judge",
      "label": "Judge",
      "tier": "opus",
      "model": "claude-opus-4-8",
      "envVar": "JUDGE_MODEL",
      "stages": [
        "blueprint",
        "domain"
      ],
      "description": "Scores BRD and designs on five dimensions; drives the improve loop."
    },
    {
      "role": "seam",
      "label": "Seam narrator",
      "tier": "sonnet",
      "model": "claude-sonnet-4-6",
      "envVar": "SEAM_MODEL",
      "stages": [
        "seams"
      ],
      "description": "Explains ranked seams in business terms (scores stay pure Cypher)."
    },
    {
      "role": "story",
      "label": "Story writer",
      "tier": "sonnet",
      "model": "claude-sonnet-4-6",
      "envVar": "STORY_MODEL",
      "stages": [
        "backlog"
      ],
      "description": "Epics first, then INVEST stories and acceptance criteria per epic."
    },
    {
      "role": "design",
      "label": "Designer",
      "tier": "opus",
      "model": "claude-opus-4-8",
      "envVar": "DESIGN_MODEL",
      "stages": [
        "domain",
        "design"
      ],
      "description": "Bounded contexts, topology decision, tactical DDD and technical design."
    },
    {
      "role": "codegen",
      "label": "Codegen",
      "tier": "sonnet",
      "model": "claude-sonnet-4-6",
      "envVar": "CODEGEN_MODEL",
      "stages": [
        "build"
      ],
      "description": "Generates story tests and minimal Spring Boot implementation."
    },
    {
      "role": "repair",
      "label": "Repair",
      "tier": "opus",
      "model": "claude-opus-4-8",
      "envVar": "REPAIR_MODEL",
      "stages": [
        "build"
      ],
      "description": "Re-generates the implementation from the failing Maven log (bounded attempts)."
    },
    {
      "role": "advisor",
      "label": "Advisor",
      "tier": "opus",
      "model": "claude-opus-4-8",
      "envVar": "ADVISOR_MODEL",
      "stages": [
        "build"
      ],
      "description": "Budgeted escalation for hard calls (ADVISOR_MAX_USES)."
    },
    {
      "role": "equivalence_triage",
      "label": "Equivalence triage",
      "tier": "haiku",
      "model": "claude-haiku-4-5-20251001",
      "envVar": "EQUIV_TRIAGE_MODEL",
      "stages": [
        "verify"
      ],
      "description": "Optional narrative over equivalence mismatches."
    }
  ],
  "buildSteps": [
    {
      "key": "context",
      "label": "Context pack",
      "module": "codegen/story_context.py",
      "mode": "deterministic",
      "description": "Graph-grounded slice for one story: COBOL paragraphs, copybooks, owned files, API contracts."
    },
    {
      "key": "tests",
      "label": "Generate tests",
      "module": "codegen/patch_agent.py · generate_story_tests",
      "mode": "deterministic",
      "toggle": "STORY_LLM_TESTS",
      "description": "JUnit acceptance tests, one per acceptance criterion, citing the story id."
    },
    {
      "key": "red",
      "label": "RED baseline",
      "module": "codegen/test_runner.py",
      "mode": "toolchain",
      "description": "Targeted mvn -Dtest run before any code: the story must start red."
    },
    {
      "key": "impl",
      "label": "Generate implementation",
      "module": "codegen/patch_agent.py · generate_story_implementation",
      "mode": "deterministic",
      "toggle": "STORY_LLM_IMPL",
      "description": "Minimal Spring Boot code with story + COBOL lineage comments."
    },
    {
      "key": "green",
      "label": "GREEN run",
      "module": "codegen/test_runner.py",
      "mode": "toolchain",
      "description": "Targeted mvn run after implementation."
    },
    {
      "key": "repair",
      "label": "Bounded repair",
      "module": "codegen/repair_loop.py",
      "mode": "llm",
      "description": "Failing log fed back to the repair role, capped attempts and cost."
    },
    {
      "key": "gate",
      "label": "Story quality gate",
      "module": "codegen/story_quality.py",
      "mode": "deterministic",
      "description": "AC coverage, lineage, test result, package scope, behaviour signals."
    },
    {
      "key": "persist",
      "label": "Record status",
      "module": "codegen/story_storage.py",
      "mode": "deterministic",
      "description": "Versioned story_codegen_status artifact; enables resume."
    }
  ],
  "techStack": {
    "source": [
      {
        "name": "Enterprise COBOL",
        "purpose": "31 online (CICS) and batch programs"
      },
      {
        "name": "CICS",
        "purpose": "Online transactions (17 programs)"
      },
      {
        "name": "VSAM KSDS",
        "purpose": "Account, card, customer, transaction files"
      },
      {
        "name": "JCL",
        "purpose": "38 batch job members"
      },
      {
        "name": "BMS",
        "purpose": "17 3270 screen maps"
      }
    ],
    "target": [
      {
        "name": "Java",
        "version": "25",
        "purpose": "Target language"
      },
      {
        "name": "Spring Boot",
        "version": "4.0.6",
        "purpose": "Services, REST APIs, batch"
      },
      {
        "name": "Maven",
        "version": "3.9",
        "purpose": "Build + mvn verify quality gates"
      },
      {
        "name": "JUnit",
        "version": "5",
        "purpose": "Story acceptance tests"
      },
      {
        "name": "ArchUnit · Checkstyle · SpotBugs · Error Prone",
        "purpose": "Quality gates"
      }
    ],
    "harness": [
      {
        "name": "ProLeap COBOL parser",
        "version": "2.4.0",
        "purpose": "tools/cobol-extractor → schemaVersion 2 JSON"
      },
      {
        "name": "Neo4j",
        "version": "5.24",
        "purpose": "Code graph (source of truth)"
      },
      {
        "name": "PostgreSQL",
        "version": "16",
        "purpose": "Runs, gates, approvals, artifacts, work units"
      },
      {
        "name": "FastAPI",
        "purpose": "Control plane (/api)"
      },
      {
        "name": "Claude Agent SDK",
        "version": "0.2.87",
        "purpose": "Bounded agents over read-only graph tools"
      },
      {
        "name": "Claude Haiku / Sonnet / Opus",
        "purpose": "Tiered by role (cost/tiering.py)"
      }
    ],
    "mappings": [
      {
        "legacy": "CICS online transaction (BMS screen)",
        "modern": "Spring Boot REST endpoint",
        "note": "Screen flows become API contracts in the technical design"
      },
      {
        "legacy": "VSAM KSDS file",
        "modern": "PostgreSQL table behind a repository",
        "note": "Writers use Legacy Mimic write-back until cut-over"
      },
      {
        "legacy": "JCL batch job step",
        "modern": "Spring Boot batch job",
        "note": "Same file contract in and out, so it can be dual-run"
      },
      {
        "legacy": "COMP-3 / zoned decimal",
        "modern": "BigDecimal with explicit scale",
        "note": "Equivalence diff tolerates scale and sign encoding only"
      },
      {
        "legacy": "Copybook record",
        "modern": "Java record / DTO",
        "note": "Field lineage kept in generated comments"
      },
      {
        "legacy": "PERFORM paragraph",
        "modern": "Service method",
        "note": "Every generated file cites its story and COBOL paragraph"
      }
    ]
  },
  "sourceCounts": {
    "carddemo": {
      "programs": 31,
      "copybooks": 30,
      "bmsCopybooks": 17,
      "bmsMaps": 17,
      "jcl": 38,
      "cicsPrograms": 17,
      "cobolLines": 20650
    }
  }
}